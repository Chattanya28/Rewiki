  "description": "Production-ready versioned wiki and documentation system using MongoDB, Express, and Mongoose with auditable revision history and rollback capabilities.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "explain": "node src/scripts/explain.js",
    "test": "node tests/api.test.js"
  },
  "keywords": [
    "mongodb",
    "mongoose",
    "express",
    "wiki",
    "documentation",
    "versioning",
    "audit-trail",
    "rollback"
